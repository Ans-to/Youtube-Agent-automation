# Python cache
__pycache__/
*.py[cod]

# Local backups and patch artifacts
*.backup*
*.before-*
*.broken-patch

# Python virtual environments (keep local runtimes and installed model dependencies out of Git)
.venv/
.venv-urdu-tts/
.venv-piper-urdu/

# Secrets and local environment
.env
.env.*
!.env.example
*token*
*secret*
*credential*

# Local runtime data
/logs/
/outputs/
/workspace/

# Personal runtime configuration and task queue
/config.json
/tasks.json

# Video renderer runtime artifacts
/video_studio/node_modules/
/video_studio/remotion/node_modules/
/video_studio/remotion/out/
/video_studio/remotion/public/audio/nokia-evolution-voice.wav
/video_studio/voices/
/video_studio/frames/
/video_studio/outputs/
/video_studio/render-manifest.json
/video_studio/narration.wav

# Atomic queue lock/temp files
/tasks.json.lock
/tasks.json.tmp-*

# Local narration intermediates and generated voice storyboard
/video_studio/voice_segments/
/video_studio/voice-storyboard.generated.json
/video_studio/*.silent.mp4
