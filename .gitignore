# Python cache
__pycache__/
*.py[cod]

# Local backups and patch artifacts
*.backup*
*.before-*
*.broken-patch

# Python virtual environments (keep local runtimes and installed model dependencies out of Git)
.venv/
.venv-urdu-tts/
.venv-piper-urdu/

# Secrets and local environment
.env
.env.*
!.env.example
*token*
*secret*
*credential*

# Local runtime data
/logs/
/outputs/
/workspace/

# Personal runtime configuration and task queue
/config.json
/tasks.json

# Video renderer runtime artifacts
/video_studio/node_modules/
/video_studio/voices/
/video_studio/frames/
/video_studio/outputs/
/video_studio/render-manifest.json
/video_studio/narration.wav

# Atomic queue lock/temp files
/tasks.json.lock
/tasks.json.tmp-*

# Local narration intermediates and generated voice storyboard
/video_studio/voice_segments/
/video_studio/voice-storyboard.generated.json
/video_studio/*.silent.mp4

# Sandbox-only tooling shims (static ffmpeg/ffprobe, chromium, npm scratch)
/.tools-bin/
/.tools-npm/

# HyperFrames project artifacts (renders and stills are rebuilt by CI)
/video_studio/hyperframes/*/renders/
/video_studio/hyperframes/*/snapshots/
/video_studio/hyperframes/*/.hyperframes/
/video_studio/hyperframes/*/node_modules/
/video_studio/hyperframes/*/assets/audio/score.wav
