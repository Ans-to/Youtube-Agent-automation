# Machine-local overrides. Copy to `.env` (Git-ignored) and edit.
# Real environment variables win over this file, so a launcher can override it.
# Only the variables below are read. Everything else is ignored on purpose.
#
# Windows PowerShell:   Copy-Item .env.example .env
# macOS / Linux:        cp .env.example .env

# --- Which installation to run ------------------------------------------------
# Point at another checkout (relative or absolute). Default: this directory.
# AGENT_HQ_HOME=C:\Users\you\Youtube-Agent-automation

# Use a different config file instead of config.json.
# AGENT_HQ_CONFIG=config\local.json

# --- Local model --------------------------------------------------------------
# The model must be reachable on a literal loopback IP; hostnames are refused.
# AGENT_HQ_MODEL_ENABLED=true
# AGENT_HQ_MODEL_BASE_URL=http://127.0.0.1:8080/v1/chat/completions
# AGENT_HQ_MODEL_NAME=local-model
# AGENT_HQ_MODEL_TIMEOUT_SECONDS=240

# --- Queue worker -------------------------------------------------------------
# AGENT_HQ_RUNNER_INTERVAL_SECONDS=60
# AGENT_HQ_RUNNER_MAX_TASKS_PER_CYCLE=1

# --- Dashboard ----------------------------------------------------------------
# Loopback only. The dashboard refuses any other host at startup.
# AGENT_HQ_DASHBOARD_HOST=127.0.0.1
# AGENT_HQ_DASHBOARD_PORT=8765
