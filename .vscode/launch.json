{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Agent HQ: Dashboard",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/dashboard.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "serverReadyAction": {
        "pattern": "Holographic Offline Agent HQ: (http://127\\.0\\.0\\.1:\\d+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Agent HQ: Process one queued task",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/agent.py",
      "args": ["--once"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Agent HQ: Task loop (60s interval)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/agent.py",
      "args": ["--loop", "--interval", "60"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
